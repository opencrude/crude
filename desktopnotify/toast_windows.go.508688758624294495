//go:build windows

package desktopnotify

import (
	"crypto/sha256"
	"encoding/hex"
	"encoding/xml"
	"fmt"
	"sync"
	"syscall"
	"unsafe"

	"golang.org/x/sys/windows/registry"
)

// Windows toast notifications for an unpackaged desktop program. The
// program registers its AppUserModelID per user under
// HKCU\Software\Classes\AppUserModelId, as the Windows App SDK does for
// unpackaged apps: no administrator rights, no shortcut, no COM server.
// A click reaches this process through the toast's Activated event while
// the process runs; Crude withdraws its toasts when it exits.
//
// Tags and the group make replacement and withdrawal exact: a Show with the
// same key replaces the toast in place, and Withdraw removes it from the
// screen and from the notification center.
const toastGroup = "crude"

type toastBackend struct {
	appID       string
	uninitialize bool
	notifier    *comObject
	history     *comObject
	factory     *comObject

	live map[string]liveToast // key -> the shown toast, held for its click event

	mu   sync.Mutex
	tags map[string]string // tag -> key, read by the click callback
}

type liveToast struct {
	toast *comObject
	token int64
}

// NotificationSetting values from windows.ui.notifications.h.
const notificationEnabled = 0

func openBackend(id Identity, activated func(string)) (backend, error) {
	if id.AppID == "" {
		return nil, fmt.Errorf("%w: no application identity", ErrUnsupported)
	}
	uninitialize, err := roInitialize()
	if err != nil {
		return nil, fmt.Errorf("%w: %v", ErrNoService, err)
	}
	b := &toastBackend{appID: id.AppID, uninitialize: uninitialize, live: make(map[string]liveToast), tags: make(map[string]string)}
	if err := b.open(id); err != nil {
		b.close()
		return nil, err
	}
	route := func(tag string) {
		b.mu.Lock()
		key, ok := b.tags[tag]
		b.mu.Unlock()
		if ok && activated != nil {
			activated(key)
		}
	}
	handlerRoute.Store(&route)
	return b, nil
}

func (b *toastBackend) open(id Identity) error {
	icon, _ := iconFile(id)
	if err := registerApp(id.AppID, id.Name, icon); err != nil {
		return fmt.Errorf("register %s for notifications: %w", id.AppID, err)
	}
	statics, err := activationFactory(classToastNotificationManager, &iidToastNotificationManagerStats)
	if err != nil {
		return fmt.Errorf("%w: %v", ErrNoService, err)
	}
	defer statics.release()
	appID, err := newHString(b.appID)
	if err != nil {
		return err
	}
	defer appID.free()
	hr, _, _ := syscall.SyscallN(statics.vtbl[slotManagerCreateToastNotifierWithID], statics.self(), uintptr(appID), uintptr(unsafe.Pointer(&b.notifier)))
	if err := check("CreateToastNotifierWithId", hr); err != nil {
		return fmt.Errorf("%w: %v", ErrNoService, err)
	}
	statics2, err := activationFactory(classToastNotificationManager, &iidToastNotificationManagerStat2)
	if err != nil {
		return fmt.Errorf("%w: %v", ErrNoService, err)
	}
	defer statics2.release()
	hr, _, _ = syscall.SyscallN(statics2.vtbl[slotManagerGetHistory], statics2.self(), uintptr(unsafe.Pointer(&b.history)))
	if err := check("get_History", hr); err != nil {
		return fmt.Errorf("%w: %v", ErrNoService, err)
	}
	if b.factory, err = activationFactory(classToastNotification, &iidToastNotificationFactory); err != nil {
		return fmt.Errorf("%w: %v", ErrNoService, err)
	}
	return nil
}

func (b *toastBackend) available() error {
	var setting int32
	hr, _, _ := syscall.SyscallN(b.notifier.vtbl[slotNotifierGetSetting], b.notifier.self(), uintptr(unsafe.Pointer(&setting)))
	if err := check("get_Setting", hr); err != nil {
		return err
	}
	if setting != notificationEnabled {
		return ErrBlocked
	}
	return nil
}

func (b *toastBackend) show(n Notification) error {
	if err := b.available(); err != nil {
		return err
	}
	document, err := toastDocument(n)
	if err != nil {
		return err
	}
	defer document.release()
	var toast *comObject
	hr, _, _ := syscall.SyscallN(b.factory.vtbl[slotFactoryCreateToastNotification], b.factory.self(), document.self(), uintptr(unsafe.Pointer(&toast)))
	if err := check("CreateToastNotification", hr); err != nil {
		return err
	}
	tag := toastTag(n.Key)
	if err := setToastIdentity(toast, tag, n.Quiet); err != nil {
		toast.release()
		return err
	}
	var token int64
	hr, _, _ = syscall.SyscallN(toast.vtbl[slotToastAddActivated], toast.self(), uintptr(unsafe.Pointer(activatedHandler())), uintptr(unsafe.Pointer(&token)))
	if err := check("add_Activated", hr); err != nil {
		toast.release()
		return err
	}
	b.mu.Lock()
	b.tags[tag] = n.Key
	b.mu.Unlock()
	hr, _, _ = syscall.SyscallN(b.notifier.vtbl[slotNotifierShow], b.notifier.self(), toast.self())
	if err := check("Show", hr); err != nil {
		releaseToast(liveToast{toast: toast, token: token})
		return err
	}
	if previous, ok := b.live[n.Key]; ok {
		releaseToast(previous)
	}
	b.live[n.Key] = liveToast{toast: toast, token: token}
	return nil
}

func (b *toastBackend) withdraw(key string) error {
	tag := toastTag(key)
	if live, ok := b.live[key]; ok {
		releaseToast(live)
		delete(b.live, key)
	}
	b.mu.Lock()
	delete(b.tags, tag)
	b.mu.Unlock()
	return b.removeFromHistory(tag)
}

func (b *toastBackend) removeFromHistory(tag string) error {
	if b.history == nil {
		return nil
	}
	values := make([]hstring, 0, 3)
	defer func() {
		for _, value := range values {
			value.free()
		}
	}()
	for _, text := range []string{tag, toastGroup, b.appID} {
		value, err := newHString(text)
		if err != nil {
			return err
		}
		values = append(values, value)
	}
	hr, _, _ := syscall.SyscallN(b.history.vtbl[slotHistoryRemoveGroupedTagWithID], b.history.self(), uintptr(values[0]), uintptr(values[1]), uintptr(values[2]))
	return check("RemoveGroupedTagWithId", hr)
}

func (b *toastBackend) close() {
	handlerRoute.Store(nil)
	for key, live := range b.live {
		releaseToast(live)
		delete(b.live, key)
	}
	b.factory.release()
	b.history.release()
	b.notifier.release()
	b.factory, b.history, b.notifier = nil, nil, nil
	if b.uninitialize {
		b.uninitialize = false
		roUninitialize()
	}
}

func releaseToast(live liveToast) {
	if live.toast == nil {
		return
	}
	_, _, _ = syscall.SyscallN(live.toast.vtbl[slotToastRemoveActivated], live.toast.self(), uintptr(live.token))
	live.toast.release()
}

func setToastIdentity(toast *comObject, tag string, quiet bool) error {
	toast2, err := toast.query(&iidToastNotification2)
	if err != nil {
		return err
	}
	defer toast2.release()
	tagValue, err := newHString(tag)
	if err != nil {
		return err
	}
	defer tagValue.free()
	groupValue, err := newHString(toastGroup)
	if err != nil {
		return err
	}
	defer groupValue.free()
	hr, _, _ := syscall.SyscallN(toast2.vtbl[slotToast2PutTag], toast2.self(), uintptr(tagValue))
	if err := check("put_Tag", hr); err != nil {
		return err
	}
	hr, _, _ = syscall.SyscallN(toast2.vtbl[slotToast2PutGroup], toast2.self(), uintptr(groupValue))
	if err := check("put_Group", hr); err != nil {
		return err
	}
	suppress := uintptr(0)
	if quiet {
		suppress = 1
	}
	hr, _, _ = syscall.SyscallN(toast2.vtbl[slotToast2PutSuppressPopup], toast2.self(), suppress)
	return check("put_SuppressPopup", hr)
}

// toastDocument parses the toast XML into the document a toast is made of.
func toastDocument(n Notification) (*comObject, error) {
	text, err := toastXML(n)
	if err != nil {
		return nil, err
	}
	instance, err := activateInstance(classXMLDocument)
	if err != nil {
		return nil, err
	}
	defer instance.release()
	io, err := instance.query(&iidXMLDocumentIO)
	if err != nil {
		return nil, err
	}
	defer io.release()
	value, err := newHString(text)
	if err != nil {
		return nil, err
	}
	defer value.free()
	hr, _, _ := syscall.SyscallN(io.vtbl[slotXMLDocumentIOLoadXML], io.self(), uintptr(value))
	if err := check("LoadXml", hr); err != nil {
		return nil, err
	}
	return instance.query(&iidXMLDocument)
}

// toastXML builds the generic toast template. encoding/xml escapes every
// text, so agent text can never add elements or attributes.
// Schema: https://learn.microsoft.com/windows/apps/design/shell/tiles-and-notifications/toast-schema
func toastXML(n Notification) (string, error) {
	type binding struct {
		Template string   `xml:"template,attr"`
		Text     []string `xml:"text"`
	}
	type toast struct {
		XMLName xml.Name `xml:"toast"`
		Binding binding  `xml:"visual>binding"`
	}
	value := toast{Binding: binding{Template: "ToastGeneric", Text: []string{n.Title}}}
	if n.Body != "" {
		value.Binding.Text = append(value.Binding.Text, n.Body)
	}
	data, err := xml.Marshal(value)
	return string(data), err
}

// toastTag is a short, fixed-size tag for a key; Windows limits tags to 64
// characters.
func toastTag(key string) string {
	sum := sha256.Sum256([]byte(key))
	return hex.EncodeToString(sum[:12])
}

// registerApp writes the per-user AppUserModelID entry that names and draws
// the toasts, only where a value differs.
func registerApp(appID, name, icon string) error {
	key, _, err := registry.CreateKey(registry.CURRENT_USER, `Software\Classes\AppUserModelId\`+appID, registry.QUERY_VALUE|registry.SET_VALUE)
	if err != nil {
		return err
	}
	defer key.Close()
	values := map[string]string{"DisplayName": name}
	if icon != "" {
		values["IconUri"] = icon
	}
	for value, want := range values {
		if current, _, err := key.GetStringValue(value); err == nil && current == want {
			continue
		}
		if err := key.SetStringValue(value, want); err != nil {
			return err
		}
	}
	return nil
}
