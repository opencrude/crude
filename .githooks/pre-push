#!/usr/bin/env bash
# Runs the layout, naming and lint gates before git sends commits.
# Enable it once per clone with: make hooks
# Rules and fixes: docs/reference/code-layout.md
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! make --no-print-directory conventions; then
	echo >&2
	echo "pre-push: the push stopped because a gate failed. Fix the errors above, commit, and push again." >&2
	exit 1
fi
